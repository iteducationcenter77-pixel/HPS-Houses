# Copy this file to .env.local for local development.
# On Vercel, add the same three names under Project Settings → Environment Variables.

# MongoDB Atlas connection string for the database user (keep the password secret)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster
MONGODB_DB=hps

# Long random string used to sign admin login sessions (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
